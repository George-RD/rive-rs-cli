  "behavior": {
    "statecharts": [
      {
        "id": "console",
        "inputs": [
          {
            "kind": "number",
            "id": "load",
            "value": {
              "kind": "literal",
              "value": 0.0,
              "unit": "scalar"
            }
          },
          {
            "kind": "bool",
            "id": "armed",
            "value": false
          },
          {
            "kind": "trigger",
            "id": "reset"
          }
        ],
        "listeners": [
          {
            "id": "arm-press",
            "target": "arm-surface",
            "listener_type": "click",
            "actions": [
              {
                "kind": "bool_change",
                "input": "armed",
                "value": true
              }
            ]
          },
          {
            "id": "reset-press",
            "target": "reset-surface",
            "listener_type": "click",
            "actions": [
              {
                "kind": "bool_change",
                "input": "armed",
                "value": false
              },
              {
                "kind": "trigger_change",
                "input": "reset"
              }
            ]
          }
        ],
        "initial": "standby",
        "states": [
          {
            "id": "standby",
            "motion": "gauge-standby-track"
          },
          {
            "id": "running",
            "blend": {
              "input": "load",
              "stops": [
                {
                  "motion": "gauge-low-track",
                  "value": {
                    "kind": "literal",
                    "value": 0.0,
                    "unit": "scalar"
                  }
                },
                {
                  "motion": "gauge-high-track",
                  "value": {
                    "kind": "literal",
                    "value": 100.0,
                    "unit": "scalar"
                  }
                }
              ]
            }
          }
        ],
        "transitions": [
          {
            "id": "engage",
            "from": "standby",
            "to": "running",
            "when": {
              "input": "armed",
              "equals": true
            }
          },
          {
            "id": "release",
            "from": "running",
            "to": "standby",
            "when": {
              "trigger": "reset"
            }
          }
        ],
        "regions": [
          {
            "id": "stream",
            "initial": "flowing",
            "states": [
              {
                "id": "flowing",
                "motion": "token-transit"
              }
            ],
            "transitions": []
          },
          {
            "id": "alert",
            "initial": "calm",
            "states": [
              {
                "id": "calm",
                "motion": "lamp-calm-track"
              },
              {
                "id": "busy",
                "motion": "lamp-busy-track"
              }
            ],
            "transitions": [
              {
                "id": "escalate",
                "from": "calm",
                "to": "busy",
                "when": {
                  "input": "load",
                  "compare": "greater_or_equal",
                  "value": {
                    "kind": "literal",
                    "value": 60.0,
                    "unit": "scalar"
                  }
                }
              },
              {
                "id": "settle",
                "from": "busy",
                "to": "calm",
                "when": {
                  "input": "load",
                  "compare": "less",
                  "value": {
                    "kind": "literal",
                    "value": 60.0,
                    "unit": "scalar"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
