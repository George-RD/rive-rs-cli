          }
        ],
        "animated_checks": [
          {
            "kind": "frames_differ",
            "from": 0,
            "to": 42
          },
          {
            "kind": "frames_differ",
            "from": 42,
            "to": 78
          },
          {
            "kind": "frames_differ",
